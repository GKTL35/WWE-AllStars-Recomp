new file mode 100644
index 0000000..55a0434
--- /dev/null
+++ b/src/core/memory_ps4.cpp
@@ -0,0 +1,272 @@
+/**
+ * @file        rex/core/memory_ps4.cpp
+ * @brief       PS4 (OpenOrbis, FreeBSD kernel) backend for rex::memory
+ *
+ * EXPERIMENTAL / UNTESTED: never run on a console. Written against OpenOrbis' libkernel and the
+ * way ps4-kit's Mesa patches use direct memory (gpu/mesa-patches/0002, 0031).
+ *
+ * Why this differs from memory_posix.cpp: the posix backend backs the 4.5 GiB guest arena with
+ * one sparse shm file and maps views of it. The PS4 has no sparse shared memory, and direct
+ * memory is real RAM. So the "file mapping" here is only a table of what each file offset means:
+ *
+ *   offset <  0x1'0000'0000  ordinary guest virtual address space (views 0x0..0xFFFFFFFF with no
+ *                            alias): address space is reserved, host pages are committed on
+ *                            demand with an anonymous mapping (AllocFixed kCommit).
+ *   offset >= 0x1'0000'0000  the 512 MiB guest physical memory: ONE direct-memory allocation,
+ *                            mapped at every alias (0xA0000000, 0xC0000000, 0xE0000000 +4 KiB,
+ *                            and the raw 0x1'0000'0000 view). Needs sceKernelEnableDmemAliasing.
+ *
+ * KNOWN LIMITATION: the views at 0x80000000 and 0x90000000 alias the same file offset on the
+ * 360 (the same XEX memory through 64 KiB and 4 KiB pages). Here they are two independent
+ * reservations, because aliasing them would need 256 MiB of real direct memory. Code that
+ * writes through one view and reads through the other will not see the data. The XEX image is
+ * loaded through the 0x80000000 view; check this if modules ever load through 0x90000000.
+ *
+ * Page granularity: direct memory maps in 16 KiB units; the guest uses 4 KiB pages, so
+ * allocation_granularity() is 64 KiB and the SDK's existing "host page larger than guest page"
+ * path (host_address_offset, as used on macOS / Android) takes care of the rest.
+ */
+
+#include <rex/platform.h>
+
+#if REX_PLATFORM_PS4
+
+#include <cerrno>
+#include <cstdint>
+#include <cstring>
+
+#include <sys/mman.h>
+#include <sys/types.h>
+
+#include <rex/logging.h>
+#include <rex/memory/utils.h>
+
+// libkernel. Declared by hand, as ps4-kit does: no header prototype can then clash.
+extern "C" {
+int sceKernelAllocateDirectMemory(off_t search_start, off_t search_end, size_t len, size_t align,
+                                  int type, off_t* phys);
+int sceKernelReleaseDirectMemory(off_t start, size_t len);
+int sceKernelMapDirectMemory(void** addr, size_t len, int prot, int flags, off_t phys,
+                             size_t align);
+int sceKernelReserveVirtualRange(void** addr, size_t len, int flags, size_t align);
+int sceKernelMunmap(void* addr, size_t len);
+int sceKernelMprotect(const void* addr, size_t len, int prot);
+int sceKernelEnableDmemAliasing(void);
+size_t sceKernelGetDirectMemorySize(void);
+}
+
+namespace rex {
+namespace memory {
+
+namespace {
+
+constexpr int kProtCpuRead = 0x01;
+constexpr int kProtCpuWrite = 0x02;
+constexpr int kProtCpuExec = 0x04;
+constexpr int kMapFixed = 0x10;
+constexpr int kWbOnion = 0;  // CPU-cached direct memory
+constexpr size_t kDirectPage = 0x4000;  // 16 KiB
+constexpr size_t kGranularity = 0x10000;  // 64 KiB, what the SDK is told
+
+constexpr uint64_t kPhysicalFileOffset = 0x100000000ull;  // see map_info in xmemory.cpp
+constexpr uint64_t kPhysicalSize = 0x20000000ull;         // 512 MiB
+
+struct PhysicalBacking {
+  off_t phys = -1;       // direct-memory offset
+  size_t size = 0;
+  bool aliasing_on = false;
+};
+
+// One guest arena per process: a single mapping handle, as in the other backends.
+PhysicalBacking g_backing;
+constexpr FileMappingHandle kHandle = 1;
+
+int ToProt(PageAccess access) {
+  switch (access) {
+    case PageAccess::kNoAccess:
+      return 0;
+    case PageAccess::kReadOnly:
+      return kProtCpuRead;
+    case PageAccess::kReadWrite:
+      return kProtCpuRead | kProtCpuWrite;
+    case PageAccess::kExecuteReadOnly:
+      return kProtCpuRead | kProtCpuExec;
+    case PageAccess::kExecuteReadWrite:
+      return kProtCpuRead | kProtCpuWrite | kProtCpuExec;
+  }
+  return 0;
+}
+
+}  // namespace
+
+size_t page_size() {
+  return kDirectPage;
+}
+size_t allocation_granularity() {
+  return kGranularity;
+}
+
+bool IsWritableExecutableMemorySupported() {
+  // The ps4-kit runtime probes this at startup (ps4_exec_probe); the guest code is ahead-of-time
+  // compiled, so the guest never needs executable memory itself.
+  return false;
+}
+
+void* AllocFixed(void* base_address, size_t length, AllocationType allocation_type,
+                 PageAccess access) {
+  const int prot = ToProt(access);
+
+  if (allocation_type == AllocationType::kReserve) {
+    // Address space only, no memory behind it. FIXED only when asked for a specific address.
+    void* addr = base_address;
+    const int r = sceKernelReserveVirtualRange(&addr, length, base_address ? kMapFixed : 0, 0);
+    if (r != 0 || (base_address && addr != base_address)) {
+      return nullptr;
+    }
+    return addr;
+  }
+
+  // kCommit / kReserveCommit: anonymous memory. On an address that is currently a reservation,
+  // MAP_FIXED replaces the reservation with backed pages (the reservation holds no memory, so
+  // nothing is lost). Never FIXED over an address nothing reserved: the caller asked for it.
+  int flags = MAP_PRIVATE | MAP_ANON;
+  if (base_address) {
+    flags |= MAP_FIXED;
+  }
+  void* result = mmap(base_address, length, prot & (kProtCpuRead | kProtCpuWrite), flags, -1, 0);
+  if (result == MAP_FAILED) {
+    return nullptr;
+  }
+  if (prot & kProtCpuExec) {
+    sceKernelMprotect(result, length, prot);
+  }
+  return result;
+}
+
+bool DeallocFixed(void* base_address, size_t length, DeallocationType deallocation_type) {
+  switch (deallocation_type) {
+    case DeallocationType::kDecommit: {
+      // Give the memory back but keep the address range reserved, so a later commit can map it.
+      void* addr = base_address;
+      if (sceKernelMunmap(base_address, length) != 0) {
+        return false;
+      }
+      return sceKernelReserveVirtualRange(&addr, length, kMapFixed, 0) == 0;
+    }
+    case DeallocationType::kRelease:
+      return sceKernelMunmap(base_address, length) == 0;
+    default:
+      return false;
+  }
+}
+
+bool Protect(void* base_address, size_t length, PageAccess access, PageAccess* out_old_access) {
+  if (out_old_access) {
+    // sceKernelVirtualQuery could report this; the callers that use it only ever restore
+    // read-write, so report that rather than guess per page.
+    *out_old_access = PageAccess::kReadWrite;
+  }
+  const int r = sceKernelMprotect(base_address, length, ToProt(access));
+  if (r != 0) {
+    REXSYS_ERROR("sceKernelMprotect({}, 0x{:X}) failed: 0x{:08X}", base_address, length,
+                 static_cast<uint32_t>(r));
+  }
+  return r == 0;
+}
+
+bool QueryProtect(void* /*base_address*/, size_t& length, PageAccess& access_out) {
+  // TODO: sceKernelVirtualQuery. Not needed until a caller depends on it on this platform.
+  access_out = PageAccess::kNoAccess;
+  length = 0;
+  return false;
+}
+
+FileMappingHandle CreateFileMappingHandle(const std::filesystem::path& /*path*/, size_t length,
+                                          PageAccess /*access*/, bool /*commit*/) {
+  // length is the whole 4.5 GiB arena; only the physical part is real memory.
+  if (g_backing.phys >= 0) {
+    return kFileMappingHandleInvalid;  // one arena per process
+  }
+  if (length < kPhysicalFileOffset + kPhysicalSize) {
+    return kFileMappingHandleInvalid;
+  }
+  off_t phys = -1;
+  const int r = sceKernelAllocateDirectMemory(0, static_cast<off_t>(sceKernelGetDirectMemorySize()),
+                                              kPhysicalSize, kGranularity, kWbOnion, &phys);
+  if (r != 0) {
+    REXSYS_ERROR("PS4: no direct memory for the 512 MiB guest physical area: 0x{:08X}",
+                 static_cast<uint32_t>(r));
+    return kFileMappingHandleInvalid;
+  }
+  g_backing.phys = phys;
+  g_backing.size = kPhysicalSize;
+
+  // Several views of the same direct memory: the kernel refuses that unless aliasing is on.
+  g_backing.aliasing_on = (sceKernelEnableDmemAliasing() == 0);
+  if (!g_backing.aliasing_on) {
+    REXSYS_ERROR("PS4: sceKernelEnableDmemAliasing() refused; guest memory mirrors cannot work");
+  }
+  return kHandle;
+}
+
+void CloseFileMappingHandle(FileMappingHandle /*handle*/, const std::filesystem::path& /*path*/) {
+  if (g_backing.phys >= 0) {
+    sceKernelReleaseDirectMemory(g_backing.phys, g_backing.size);
+    g_backing = PhysicalBacking{};
+  }
+}
+
+void* MapFileView(FileMappingHandle handle, void* base_address, size_t length, PageAccess access,
+                  size_t file_offset) {
+  if (handle != kHandle || (file_offset % kGranularity) != 0) {
+    return nullptr;
+  }
+
+  if (file_offset < kPhysicalFileOffset) {
+    // Plain guest virtual space: reserve only. Hint address, no FIXED: if the kernel puts it
+    // elsewhere this arena base is taken and the caller tries the next one.
+    void* addr = base_address;
+    if (sceKernelReserveVirtualRange(&addr, length, 0, 0) != 0) {
+      return nullptr;
+    }
+    if (base_address && addr != base_address) {
+      sceKernelMunmap(addr, length);
+      return nullptr;
+    }
+    return addr;
+  }
+
+  // A view of the physical area.
+  const uint64_t offset_in_phys = file_offset - kPhysicalFileOffset;
+  if (!g_backing.aliasing_on || offset_in_phys + length > g_backing.size + kGranularity) {
+    return nullptr;
+  }
+  // The 0xE0000000 view starts 4 KiB into the physical area (target 0x100001000); the SDK
+  // masks that to granularity before it gets here, and adds the 4 KiB itself on the CPU side.
+  void* addr = base_address;
+  const size_t map_len = (offset_in_phys + length > g_backing.size)
+                             ? static_cast<size_t>(g_backing.size - offset_in_phys)
+                             : length;
+  const int r = sceKernelMapDirectMemory(&addr, map_len, ToProt(access), 0,
+                                         g_backing.phys + static_cast<off_t>(offset_in_phys),
+                                         kGranularity);
+  if (r != 0) {
+    REXSYS_ERROR("PS4: mapping physical view at {} (+0x{:X}, 0x{:X}) failed: 0x{:08X}",
+                 base_address, offset_in_phys, map_len, static_cast<uint32_t>(r));
+    return nullptr;
+  }
+  if (base_address && addr != base_address) {
+    sceKernelMunmap(addr, map_len);
+    return nullptr;
+  }
+  return addr;
+}
+
+bool UnmapFileView(FileMappingHandle /*handle*/, void* base_address, size_t length) {
+  return sceKernelMunmap(base_address, length) == 0;
+}
+
+}  // namespace memory
+}  // namespace rex
+
+#endif  // REX_PLATFORM_PS4
