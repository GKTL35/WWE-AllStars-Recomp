+// PS4 priorities run 256 (most urgent) to 767, default about 700. Guest priorities are the
+// Windows-style -15..+15 (0 normal). Equal priorities are not time-sliced on the PS4, so the
+// guest's relative priorities matter (MP3-PS4 README: applying them took busy fights from 4-5
+// to 13-17 fps). Heuristic mapping, 15 steps per guest level; tune on hardware.
+static int ps4_priority_from_guest(int guest) {
+  int p = 700 - guest * 15;
+  return p < 256 ? 256 : (p > 767 ? 767 : p);
+}
+static int guest_priority_from_ps4(int ps4) {
+  return (700 - ps4) / 15;
+}
