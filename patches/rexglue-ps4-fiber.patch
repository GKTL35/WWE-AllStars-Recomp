+/**
+ * @file        rex/core/fiber_ps4.cpp
+ * @brief       PS4 (x86-64 System V) backend for rex::thread::Fiber
+ *
+ * EXPERIMENTAL. OpenOrbis only declares makecontext/swapcontext as stubs, so the switch is a
+ * hand-written register swap. Saved state: rbp, rbx, r12-r15, MXCSR and the x87 control word
+ * (everything the System V ABI makes callee-saved). The routine is plain x86-64, so it is
+ * testable on any Linux x86-64 host (see tests/fiber_ps4_selftest.cpp).
+ *
+ * @license     BSD 3-Clause License
+ */
+
+#include <rex/platform.h>
+#if REX_PLATFORM_PS4
+
+#include <rex/thread/fiber.h>
+
+#include <cstdlib>
+#include <cstring>
+#include <sys/mman.h>
+
+extern "C" void rex_ps4_fiber_switch(void** save_sp, void* load_sp);
+
+// Frame layout at a saved sp (low to high): [mxcsr:u32 fpucw:u16 pad:u16] r15 r14 r13 r12 rbx rbp
+// [return address]. A new fiber's frame is built by hand so the first switch "returns" into
+// Trampoline with rsp = 8 (mod 16), as after a call.
+__asm__(R"(
+.text
+.globl rex_ps4_fiber_switch
+.type rex_ps4_fiber_switch,@function
+.p2align 4
+rex_ps4_fiber_switch:
+    pushq %rbp
+    pushq %rbx
+    pushq %r12
+    pushq %r13
+    pushq %r14
+    pushq %r15
+    subq  $8, %rsp
+    stmxcsr (%rsp)
+    fnstcw  4(%rsp)
+    movq  %rsp, (%rdi)
+    movq  %rsi, %rsp
+    ldmxcsr (%rsp)
+    fldcw   4(%rsp)
+    addq  $8, %rsp
+    popq  %r15
+    popq  %r14
+    popq  %r13
+    popq  %r12
+    popq  %rbx
+    popq  %rbp
+    ret
+.size rex_ps4_fiber_switch, .-rex_ps4_fiber_switch
+)");
+
+namespace rex::thread {
+
+thread_local Fiber* Fiber::tls_current_ = nullptr;
+
+Fiber* Fiber::ConvertCurrentThread() {
+  auto* f = new Fiber();
+  f->is_thread_fiber_ = true;  // its sp_ is filled in by the first SwitchTo away from it
+  tls_current_ = f;
+  return f;
+}
+
+Fiber* Fiber::Create(size_t stack_size, void (*entry)(void*), void* arg) {
+  constexpr size_t kGuard = 4096;
+  constexpr size_t kAlign = 16;
+  stack_size = (stack_size + kAlign - 1) & ~(kAlign - 1);
+
+  // One mapping: [guard page][stack]. The guard turns an overflow into a fault the crash log shows.
+  const size_t total = stack_size + kGuard;
+  void* mem = mmap(nullptr, total, PROT_READ | PROT_WRITE, MAP_PRIVATE | MAP_ANON, -1, 0);
+  if (mem == MAP_FAILED) {
+    return nullptr;
+  }
+  mprotect(mem, kGuard, PROT_NONE);
+
+  auto* f = new Fiber();
+  f->entry_ = entry;
+  f->arg_ = arg;
+  f->stack_ = static_cast<uint8_t*>(mem);
+  f->stack_size_ = total;
+
+  uintptr_t top = reinterpret_cast<uintptr_t>(mem) + total;
+  top &= ~static_cast<uintptr_t>(kAlign - 1);
+
+  // slot[0] = return address slot (16-aligned), slot[1] = fake caller return address (0).
+  auto* ret_slot = reinterpret_cast<uint64_t*>(top - 16);
+  ret_slot[0] = reinterpret_cast<uint64_t>(&Fiber::Trampoline);
+  ret_slot[1] = 0;
+
+  // Below the return address: rbp rbx r12 r13 r14 r15 (6 x 8), then the 8-byte FP control slot.
+  auto* frame = ret_slot - 6 - 1;
+  std::memset(frame, 0, 7 * sizeof(uint64_t));
+  const uint32_t mxcsr = 0x1F80;  // default: all exceptions masked, round to nearest
+  const uint16_t fpucw = 0x037F;  // default: extended precision, all exceptions masked
+  std::memcpy(reinterpret_cast<uint8_t*>(frame), &mxcsr, 4);
+  std::memcpy(reinterpret_cast<uint8_t*>(frame) + 4, &fpucw, 2);
+  f->sp_ = frame;
+  return f;
+}
+
+/*static*/ void Fiber::Trampoline() {
+  // tls_current_ was updated by SwitchTo before the switch landed here.
+  Fiber* f = tls_current_;
+  f->entry_(f->arg_);
+  // A fiber entry must switch away for good instead of returning: there is no caller to return to.
+  std::abort();
+}
+
+void Fiber::SwitchTo(Fiber* target) {
+  Fiber* from = tls_current_;
+  tls_current_ = target;
+  rex_ps4_fiber_switch(&from->sp_, target->sp_);
+}
+
+void Fiber::Destroy() {
+  if (is_thread_fiber_) {
+    tls_current_ = nullptr;
+  } else {
+    if (this == tls_current_) {
+      std::abort();  // destroying the running fiber
+    }
+    if (stack_) {
+      munmap(stack_, stack_size_);
+    }
+  }
+  delete this;
+}
+
+}  // namespace rex::thread
+
+#endif  // REX_PLATFORM_PS4
