diff --git a/include/rex/ui/surface_ps4.h b/include/rex/ui/surface_ps4.h
new file mode 100644
index 0000000..84c14d6
--- /dev/null
+++ b/include/rex/ui/surface_ps4.h
@@ -0,0 +1,26 @@
+#pragma once
+/**
+ * @file        ui/surface_ps4.h
+ * @brief       PS4 VideoOut surface (a fixed 1920x1080 screen)
+ */
+
+#include <rex/ui/surface.h>
+
+namespace rex {
+namespace ui {
+
+class Ps4VideoOutSurface final : public Surface {
+ public:
+  Ps4VideoOutSurface() = default;
+  TypeIndex GetType() const override { return kTypeIndex_Ps4VideoOut; }
+
+ protected:
+  bool GetSizeImpl(uint32_t& width_out, uint32_t& height_out) const override {
+    width_out = 1920;
+    height_out = 1080;
+    return true;
+  }
+};
+
+}  // namespace ui
+}  // namespace rex
